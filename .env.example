# Server-side OpenRouter only. Leave blank in the browser and on phones.
# Puter users sign in inside the page. Phone users paste a key that stays on the device.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Space Bunny Alpha uses the same key. The router asks for stealth/space-bunny-alpha.

# Vercel AI Gateway. A non-empty AI_GATEWAY_API_KEY is sent. If it is empty, VERCEL_OIDC_TOKEN is sent.
# On Vercel, the platform sets VERCEL_OIDC_TOKEN. Do not put either value in website JavaScript.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
AI_GATEWAY_MODEL=openai/gpt-4o-mini

# Gemini API. Sent as the x-goog-api-key header. Do not put this in website JavaScript.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# LLMAPI (https://api.llmapi.ai). Do not put this in website JavaScript.
LLM_API_KEY=
LLMAPI_MODEL=gpt-4o

# Laya is not called. No key from this file is read until the service is confirmed.
